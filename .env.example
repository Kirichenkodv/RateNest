# Секретный ключ Django. Для локальной разработки сгенерируйте его командой:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# Режим отладки. В production установите False.
DJANGO_DEBUG=True

# Разрешённые хосты, перечисленные через запятую.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# URL базы данных в формате: postgres://user:password@host:port/dbname
DATABASE_URL=postgres://user:pass@localhost:5432/name
# URL Redis в формате: redis://host:port/db
REDIS_URL=redis://localhost:6379/0

